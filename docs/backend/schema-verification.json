  "media_policies": [
    {
      "cmd": "SELECT",
      "qual": "((bucket_id = 'uploads'::text) AND (((storage.foldername(name))[1] = (( SELECT auth.uid() AS uid))::text) OR (EXISTS ( SELECT 1\n   FROM messages m\n  WHERE (((m.data ->> 'attachment_path'::text) = ('uploads/'::text || objects.name)) AND private.member(m.conversation_id, ( SELECT auth.uid() AS uid))))) OR (EXISTS ( SELECT 1\n   FROM profiles p\n  WHERE ((p.data ->> 'avatar_path'::text) = ('uploads/'::text || objects.name))))))",
